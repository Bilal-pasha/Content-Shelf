# Server Configuration
NODE_ENV=development
SERVER_PORT=8000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=video_app

# JWT Configuration
# Required in non-development environments — the app refuses to start without these.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Configuration
# Mobile-only OAuth: the client verifies an ID token via google-auth-library.
# GOOGLE_CLIENT_ID must be the WEB client ID — the mobile SDK is configured
# with webClientId, so tokens are minted for it on both platforms. This is the
# only value required.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional extra accepted token audiences (defensive — not needed today).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Unused by the current mobile-only flow (no server-side callback).
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# CORS Configuration — comma-separated list of allowed origins, no wildcard
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:8081

# Universal-link domain the mobile app registers (see mobile/app.json
# associatedDomains / intentFilters) — password-reset emails link here so
# tapping the link opens the app directly.
APP_UNIVERSAL_LINK_BASE=https://online2.video-mobile-application.com

# Outbound email (password reset). Leave unset in development — the reset
# link is logged instead of emailed when these are not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
# API Configuration
# http://localhost is fine for local dev only. Any preview/production build
# MUST point at an https:// URL — the app talks auth cookies and tokens over
# this connection, and app.json currently sets usesCleartextTraffic: true for
# Android (a dev convenience). Before shipping a production build, put the
# API behind TLS and flip that flag off in mobile/app.json.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Configuration
# IMPORTANT: Use the WEB Client ID (not Android/iOS client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional: iOS Client ID for iOS-specific features
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
